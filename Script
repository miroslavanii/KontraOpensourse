track(resizeHandle.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        resizing = true
        resizeStartInput = input.Position
        resizeStartSize = main.Size
        resizeStartPosition = main.Position
        resizeDragInput = nil
    end
end))
track(resizeHandle.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        resizeDragInput = input
    end
end))
track(UserInputService.InputChanged:Connect(function(input)
    if not resizing or not resizeDragInput or input ~= resizeDragInput or not resizeStartInput or not resizeStartSize then
        return
    end
    local activeScale = math.max(scale.Scale, 0.35)
    local delta = input.Position - resizeStartInput
    local startWidth = resizeStartSize.X.Offset
    local startHeight = resizeStartSize.Y.Offset
    local newWidth = math.clamp(startWidth + delta.X / activeScale, 720, 1080)
    local newHeight = math.clamp(startHeight + delta.Y / activeScale, 470, 800)
    main.Size = UDim2.fromOffset(newWidth, newHeight)
    main.Position = UDim2.new(
        resizeStartPosition.X.Scale,
        resizeStartPosition.X.Offset + (newWidth - startWidth) * activeScale / 2,
        resizeStartPosition.Y.Scale,
        resizeStartPosition.Y.Offset + (newHeight - startHeight) * activeScale / 2
    )
end))
track(UserInputService.InputEnded:Connect(function(input)
    if resizing and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
        resizing = false
        resizeDragInput = nil
        resizeStartInput = nil
        resizeStartSize = nil
        resizeStartPosition = nil
        updateScale()
    end
