local function track(connection)
    table.insert(connections, connection)
    return connection
end

local function safeDisconnectAll()
    for _, connection in ipairs(connections) do
        pcall(function() connection:Disconnect() end)
    end
    table.clear(connections)
end

local function addCorner(object, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius or 8)
    corner.Parent = object
    return corner
end

local function addStroke(object, role, thickness, transparency)
    local stroke = Instance.new("UIStroke")
    stroke.Thickness = thickness or 1
    stroke.Transparency = transparency or 0
    stroke.Parent = object
    roleMap[stroke] = role or "stroke"
    return stroke
end

local function setRole(object, role)
    roleMap[object] = role
    local t = theme
    if role == "main" then object.BackgroundColor3 = t.bg
    elseif role == "header" then object.BackgroundColor3 = t.header
    elseif role == "panel" then
        object.BackgroundColor3 = t.panel
        if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then object.TextColor3 = t.text end
    elseif role == "control" or role == "tabOff" then
        object.BackgroundColor3 = t.control
        if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then object.TextColor3 = t.text end
    elseif role == "active" or role == "tabOn" then
        object.BackgroundColor3 = t.active
        if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then object.TextColor3 = t.text end
    elseif role == "text" then
        if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then object.TextColor3 = t.text end
    elseif role == "muted" then
        if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then object.TextColor3 = t.muted end
    elseif role == "stroke" and object:IsA("UIStroke") then
        object.Color = t.stroke
    elseif role == "accent" then
        if object:IsA("UIStroke") then
            object.Color = t.accent
        elseif object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
            object.TextColor3 = t.accent
        else
            object.BackgroundColor3 = t.accent
        end
    end
    return object
end

local function applyTheme()
    if themeName == "RGB" then
        local customColor = Color3.fromRGB(rgbValues.R, rgbValues.G, rgbValues.B)
        theme = {
            bg = Color3.fromRGB(7, 7, 10), header = Color3.fromRGB(15, 11, 16),
            panel = Color3.fromRGB(20, 17, 24), control = Color3.fromRGB(30, 23, 36),
            active = customColor:Lerp(Color3.new(0, 0, 0), 0.56),
            text = Color3.fromRGB(250, 248, 252), muted = Color3.fromRGB(184, 177, 194),
            stroke = customColor, accent = customColor,
        }
    else
        theme = THEMES[themeName] or THEMES.Red
    end
    for object, role in pairs(roleMap) do
        if object and object.Parent then
            setRole(object, role)
        else
            roleMap[object] = nil
        end
    end
    for _, page in ipairs(pages) do
        if page and page.Parent then page.ScrollBarImageColor3 = theme.accent end
    end
end

local function setRGBValue(key, input)
    local parsed = tonumber(input.Text)
    if not parsed then
        input.Text = tostring(rgbValues[key])
        return
    end
    parsed = math.clamp(math.floor(parsed + 0.5), 0, 255)
    rgbValues[key] = parsed
    for _, box in ipairs(rgbBoxes[key]) do
        if box and box.Parent then box.Text = tostring(parsed) end
    end
    if themeName == "RGB" then
        applyTheme()
        if refreshOverviewThemeButtons then refreshOverviewThemeButtons() end
    end
end

local function makeLabel(parent, text, size, position, textSize, role, font, alignment)
    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Size = size
    label.Position = position
    label.Text = text
    label.TextSize = textSize or 12
    label.Font = font or Enum.Font.Gotham
    label.TextXAlignment = alignment or Enum.TextXAlignment.Left
    label.TextYAlignment = Enum.TextYAlignment.Center
    label.Parent = parent
    setRole(label, role or "text")
    return label
end

local function makeButton(parent, text, size, position, role)
