local function removeESP(target)
    local objects = espObjects[target]
    if objects then
        if objects.highlight then objects.highlight:Destroy() end
        if objects.nameTag then objects.nameTag:Destroy() end
        if objects.conn then objects.conn:Disconnect() end
        espObjects[target] = nil
    end
end

local function addESP(target)
    if not settings.Enabled or target == player or destroyed then return end
    local character = target.Character
    if not character then
        removeESP(target)
        return
    end

    removeESP(target)
    local objects = {character = character}

    if settings.Highlights then
        local highlight = Instance.new("Highlight")
        highlight.Name = "PlayerESP"
        highlight.Adornee = character
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.FillColor = settings.FillColor
        highlight.OutlineColor = settings.OutlineColor
        highlight.FillTransparency = settings.Fill and 0.5 or 1
        highlight.OutlineTransparency = settings.Outline and 0 or 1
        highlight.Parent = screenGui
        objects.highlight = highlight
    end

    if settings.Names then
        local head = character:FindFirstChild("Head")
        if head then
            local tag = Instance.new("BillboardGui")
            tag.Name = "ESPName"
            tag.Adornee = head
            tag.Size = UDim2.fromOffset(220, 32)
            tag.StudsOffset = Vector3.new(0, 2.5, 0)
            tag.AlwaysOnTop = true
            tag.Parent = screenGui

            local label = Instance.new("TextLabel")
            label.Name = "DistanceLabel"
            label.Size = UDim2.fromScale(1, 1)
            label.BackgroundTransparency = 1
            label.TextColor3 = Color3.new(1, 1, 1)
            label.TextStrokeTransparency = 0
            label.TextScaled = true
            label.Font = Enum.Font.GothamBold
            label.Parent = tag

            objects.nameTag = tag
            objects.label = label

            objects.conn = RunService.RenderStepped:Connect(function()
                if not character or not character:FindFirstChild("HumanoidRootPart") or not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then
                    return
                end
