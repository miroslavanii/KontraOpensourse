local confettiRandom = Random.new()
local confettiColors = {
    Color3.fromRGB(255, 35, 55), Color3.fromRGB(170, 10, 28),
    Color3.fromRGB(255, 200, 92), Color3.fromRGB(245, 245, 248),
    Color3.fromRGB(47, 225, 205), Color3.fromRGB(151, 96, 255),
}
local confettiEnabled = true
local function spawnConfetti()
    if not confettiEnabled then return end
    local camera = workspace.CurrentCamera
    if not camera then return end
    local viewport = camera.ViewportSize
    local bounds = main.AbsoluteSize
    local origin = main.AbsolutePosition
    local count = 62
    for index = 1, count do
        local width = confettiRandom:NextInteger(4, 8)
        local height = confettiRandom:NextInteger(7, 14)
        local left = math.clamp(math.floor(origin.X - 45), 0, math.max(0, viewport.X - 1))
        local right = math.clamp(math.floor(origin.X + bounds.X + 45), left + 1, math.max(left + 1, viewport.X))
        local startX = confettiRandom:NextInteger(left, right)
        local top = math.clamp(math.floor(origin.Y - 70), 0, math.max(0, viewport.Y - 1))
        local lower = math.clamp(math.floor(origin.Y + bounds.Y * 0.62), top + 1, math.max(top + 1, viewport.Y))
        local startY = confettiRandom:NextInteger(top, lower)
        local piece = Instance.new("Frame")
        piece.Name = "OnixConfetti"
        piece.BorderSizePixel = 0
        piece.BackgroundColor3 = confettiColors[confettiRandom:NextInteger(1, #confettiColors)]
        piece.Size = UDim2.fromOffset(width, height)
        piece.Position = UDim2.fromOffset(startX, startY)
        piece.Rotation = confettiRandom:NextInteger(-30, 30)
        piece.ZIndex = 60
        piece.Parent = screenGui
        addCorner(piece, confettiRandom:NextInteger(1, 3))
        local duration = confettiRandom:NextNumber(2.15, 3.05)
        local animation = TweenService:Create(
            piece,
            TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
            {
                Position = UDim2.fromOffset(
                    startX + confettiRandom:NextInteger(-100, 100),
                    math.min(viewport.Y + 30, startY + confettiRandom:NextInteger(140, 290))
                ),
                Rotation = confettiRandom:NextInteger(-420, 420),
                BackgroundTransparency = 1,
                Size = UDim2.fromOffset(1, 2),
            }
        )
        animation:Play()
        task.delay(duration + 0.15, function()
            if piece and piece.Parent then piece:Destroy() end
        end)
    end
end

