-- Tab switching handler
local function selectTab(tabName)
    currentTab = tabName
    overviewPage.Visible = tabName == "Overview"
    espPage.Visible = tabName == "ESP"
    movementsPage.Visible = tabName == "Movements"
    settingsPage.Visible = tabName == "Settings"
    setRole(overviewTab, tabName == "Overview" and "tabOn" or "tabOff")
    setRole(espTab, tabName == "ESP" and "tabOn" or "tabOff")
    setRole(movementsTab, tabName == "Movements" and "tabOn" or "tabOff")
    setRole(settingsTab, tabName == "Settings" and "tabOn" or "tabOff")
end

track(overviewTab.Activated:Connect(function() selectTab("Overview") end))
track(espTab.Activated:Connect(function() selectTab("ESP") end))
track(movementsTab.Activated:Connect(function() selectTab("Movements") end))
track(settingsTab.Activated:Connect(function() selectTab("Settings") end))

local function openMenu()
    if animating or menuOpen then return end
    animating = true
    menuOpen = true
    main.Visible = true
    main.GroupTransparency = 1
    local finalPosition = main.Position
    local startPosition = UDim2.new(finalPosition.X.Scale, finalPosition.X.Offset, finalPosition.Y.Scale, finalPosition.Y.Offset + 145)
    main.Position = startPosition
    updateScale()
    scale.Scale = targetScale * 0.86
    local fade = TweenService:Create(main, TweenInfo.new(0.34, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { GroupTransparency = 0 })
    local slide = TweenService:Create(main, TweenInfo.new(0.42, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { Position = finalPosition })
    local pop = TweenService:Create(scale, TweenInfo.new(0.38, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = targetScale })
    fade:Play()
    slide:Play()
    pop:Play()
    pop.Completed:Wait()
    animating = false
    hint.Text = "ONIX  ·  X / CTRL  ·  CLOSE MENU"
    task.delay(0.12, function()
        if menuOpen and main.Visible then spawnConfetti() end
    end)
end

local function closeMenu()
    if animating or not menuOpen then return end
    animating = true
    menuOpen = false
    local finalPosition = main.Position
    local exitPosition = UDim2.new(finalPosition.X.Scale, finalPosition.X.Offset, finalPosition.Y.Scale, finalPosition.Y.Offset + 110)
    local fade = TweenService:Create(main, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { GroupTransparency = 1 })
    local slide = TweenService:Create(main, TweenInfo.new(0.24, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Position = exitPosition })
    fade:Play()
    slide:Play()
    slide.Completed:Wait()
    main.Visible = false
    main.Position = finalPosition
    updateScale()
    animating = false
    hint.Text = "ONIX  ·  X / CTRL  ·  OPEN MENU"
end

local function toggleMenu()
    if animating then return end
    task.spawn(function()
        if menuOpen then closeMenu() else openMenu() end
    end)
end

track(hint.Activated:Connect(toggleMenu))
track(UserInputService.InputBegan:Connect(function(input, processed)
    if processed or UserInputService:GetFocusedTextBox() then return end
    if input.KeyCode == Enum.KeyCode.X or input.KeyCode == Enum.KeyCode.LeftControl then
        toggleMenu()
    end
end))

