local modalAnimating = false
local function showModal()
    if modalAnimating or warningModal.Visible then return end
    modalAnimating = true
    warningModal.GroupTransparency = 1
    modalScale.Scale = 0.8
    warningModal.Visible = true

    TweenService:Create(warningModal, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {GroupTransparency = 0}):Play()
    local scaleTw = TweenService:Create(modalScale, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1})
    scaleTw:Play()
    scaleTw.Completed:Wait()
    modalAnimating = false
end

local function hideModal()
    if modalAnimating or not warningModal.Visible then return end
    modalAnimating = true

    local fadeTween = TweenService:Create(warningModal, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {GroupTransparency = 1})
    local scaleTween = TweenService:Create(modalScale, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Scale = 0.8})
    fadeTween:Play()
    scaleTween:Play()
    scaleTween.Completed:Wait()
    warningModal.Visible = false
    modalAnimating = false
end

local function destroyGUI()
    if destroyed then return end
    destroyed = true
    safeDisconnectAll()

    warningModal.Visible = false
    TweenService:Create(main, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {GroupTransparency = 1}):Play()
    local scaleTween = TweenService:Create(scale, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Scale = 0.85})
    scaleTween:Play()
    scaleTween.Completed:Wait()

    screenGui:Destroy()
end

